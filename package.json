{
  "name": "thousands",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:worker",
    "build:worker": "esbuild worker/index.ts --bundle --format=esm --target=es2022 --outfile=dist/_worker.js --log-level=warning",
    "build:crazygames": "tsc --noEmit && VITE_PLATFORM=crazygames vite build --outDir dist-crazygames --emptyOutDir && node tools/pack-crazygames.mjs",
    "build:yandex": "tsc --noEmit && VITE_PLATFORM=yandex VITE_API_BASE=https://thousands.life/api vite build --outDir dist-yandex",
    "preview": "vite preview",
    "test": "vitest run",
    "test:worker": "node --no-warnings tools/qa/worker-test.mjs",
    "prompts": "vite-node tools/export-prompts.ts",
    "stats": "vite-node tools/stats.ts",
    "check": "vite-node tools/check.ts",
    "deadly": "vite-node tools/deadly.ts",
    "marriage": "vite-node tools/marriage-stats.ts",
    "music": "node tools/gen/music.mjs",
    "achievements": "vite-node tools/achievements.ts --",
    "dream-review": "vite-node tools/dream-review.ts",
    "size": "node tools/size.mjs",
    "longevity": "vite-node tools/longevity.ts --"
  },
  "devDependencies": {
    "@fontsource/pt-serif": "^5.3.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "preact": "^10.29.8"
  },
  "size": {
    "dist_mb": 45,
    "first_mb": 3.5,
    "image_kb": 30,
    "atlas_kb": 300
  }
}
