{
  "name": "thousands",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:worker",
    "build:worker": "esbuild worker/index.ts --bundle --format=esm --target=es2022 --outfile=dist/_worker.js --log-level=warning",
    "build:yandex": "tsc --noEmit && VITE_PLATFORM=yandex VITE_API_BASE=https://thousands.life/api vite build --outDir dist-yandex",
    "preview": "vite preview",
    "test": "vitest run",
    "test:worker": "node --no-warnings tools/qa/worker-test.mjs",
    "prompts": "vite-node tools/export-prompts.ts",
    "stats": "vite-node tools/stats.ts",
    "check": "vite-node tools/check.ts",
    "deadly": "vite-node tools/deadly.ts",
    "marriage": "vite-node tools/marriage-stats.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "preact": "^10.29.8"
  }
}
